# ==============================================================================
# PrepMaster Pro — Git Ignore Rules
# ==============================================================================

# 1. Environment Secrets & Credentials (Keep local ONLY)
.env
.env.*
*.env
backend/src/.env
backend/.env
!.env.example
!backend/.env.example

# 2. Local User Database & Temporary State (Never push personal progress/passwords)
backend/data/tracker.json
backend/data/*.tmp
backend/data/*.db*
*.tmp

# 3. Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# 4. Build Artifacts & Caches
dist/
frontend/dist/
.angular/
frontend/.angular/
/tmp
/out-tsc
/bazel-out

# 5. Logs & Debug Reports
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 6. IDEs & Operating System Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# 7. AI & Tool Scratch
.agents/
